{
  "name": "console-plugin-capsule",
  "version": "0.0.6",
  "description": "OpenShift console plugin for capsule",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/baswag/console-plugin-capsule.git"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "yarn clean && NODE_ENV=production yarn webpack",
    "build-dev": "yarn clean && yarn webpack",
    "coverage": "jest --coverage",
    "start": "yarn webpack serve --progress",
    "start-console": "./start-console.sh",
    "i18n": "./i18n-scripts/build-i18n.sh && node ./i18n-scripts/set-english-defaults.js",
    "test": "LANG=en_US.UTF-8 jest",
    "lint": "yarn eslint src integration-tests --fix --max-warnings 0 && stylelint 'src/**/*.css' --allow-empty-input --fix",
    "test-e2e": "playwright test --headed",
    "test-e2e-headless": "playwright test",
    "webpack": "node -r ts-node/register ./node_modules/.bin/webpack"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "@kubernetes/client-node": "^2.0.2",
    "@openshift-console/dynamic-plugin-sdk": "4.20-latest",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.20-latest",
    "@patternfly/react-core": "^6.7.0",
    "@patternfly/react-data-view": "^6.7.0",
    "@patternfly/react-icons": "^6.7.0",
    "@patternfly/react-table": "^6.7.0",
    "@playwright/browser-chromium": "^1.65.0",
    "@playwright/test": "^1.65.0",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^14.6.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^17.0.93",
    "@types/react-dom": "^17.0.26",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^17.14.0",
    "i18next": "^27.1.1",
    "i18next-parser": "^9.4.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-junit": "^17.0.0",
    "pluralize": "^8.0.0",
    "prettier": "^3.9.10",
    "prettier-stylelint": "^0.4.2",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-error-boundary": "^5.0.0",
    "react-i18next": "^11.18.6",
    "react-router-dom-v5-compat": "^6.30.6",
    "style-loader": "^4.0.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "swc-loader": "^0.2.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  },
  "dependenciesMeta": {
    "@playwright/browser-chromium": {
      "built": true
    }
  },
  "consolePlugin": {
    "name": "console-plugin-capsule",
    "version": "0.0.6",
    "displayName": "Capsule",
    "description": "An OpenShift Console Plugin for Capsule",
    "exposedModules": {
      "TenantsPage": "./components/TenantsPage",
      "TenantNamespacesPage": "./components/TenantNamespacesPage",
      "GlobalResourceQuotasPage": "./components/GlobalResourceQuotasPage",
      "GlobalResourceQuotaDetailPage": "./components/GlobalResourceQuotaDetailPage",
      "TenantNamespaceDetailPage": "./components/TenantNamespaceDetailPage",
      "TenantResourcePage": "./components/TenantResourcePage"
    },
    "dependencies": {
      "@console/pluginAPI": "^4.20.0"
    }
  },
  "packageManager": "yarn@4.15.0"
}
